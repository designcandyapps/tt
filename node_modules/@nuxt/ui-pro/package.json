{
  "name": "@nuxt/ui-pro",
  "description": "Ship beautiful web applications at the speed of light with Nuxt UI Pro.",
  "type": "module",
  "version": "1.8.2",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/ui-pro.git"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "assets",
    "components",
    "composables",
    "lib",
    "modules",
    "plugins",
    "types",
    "app.config.ts",
    "nuxt.config.ts",
    "tailwind.config.ts"
  ],
  "theme": {
    "env": "NUXT_UI_PRO_LICENSE",
    "link": "https://ui.nuxt.com/pro/pricing"
  },
  "scripts": {
    "dev": "DEV=true nuxi dev .docs",
    "build": "DEV=true nuxi generate .docs",
    "play": "nuxi dev .playground",
    "prepare": "DEV=true nuxi prepare .docs",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck",
    "release": "release-it",
    "test": "TZ=Europe/Paris vitest"
  },
  "dependencies": {
    "@iconify-json/vscode-icons": "^1.2.30",
    "@nuxt/ui": "^2.22.3",
    "@vueuse/core": "^13.8.0",
    "defu": "^6.1.4",
    "git-url-parse": "^16.1.0",
    "ofetch": "^1.4.1",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "vue3-smooth-dnd": "^0.0.6"
  },
  "devDependencies": {
    "@nuxt/content": "^2.13.4",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/test-utils": "^3.19.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.34.0",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.0.3",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-environment-nuxt": "^1.0.1",
    "vue-tsc": "^3.0.6",
    "zod": "^4.1.5"
  },
  "resolutions": {
    "@nuxt/ui-pro": "workspace:*",
    "chokidar": "3.6.0"
  }
}
